{
  "name": "ai-learning-harness",
  "version": "0.2.0",
  "description": "Open-source AI study-plan harness: track a learning path, auto-generate study docs with your own LLM key, run it as a desktop app.",
  "main": "main.js",
  "license": "MIT",
  "author": "Arnav",
  "repository": "github:Arrnnnaav/ai-learning-harness",
  "homepage": "https://github.com/Arrnnnaav/ai-learning-harness",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish=never",
    "release": "electron-builder --publish=always"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.arnav.ailearningharness",
    "productName": "AI Learning Harness",
    "files": [
      "main.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
